# Copie este arquivo para .env.local e preencha com suas chaves.

# URL da API do Atlas CRM (backend .NET)
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Clerk (login e cadastro) ---
# Crie uma aplicação em https://dashboard.clerk.com e copie a Publishable Key.
# Sem esta chave o login volta automaticamente para email/senha do backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# No backend (src/API/appsettings.json ou variáveis de ambiente), configure também:
#   Clerk:Authority  -> Frontend API URL da sua aplicação (ex.: https://xxxxx.clerk.accounts.dev)
#   Clerk:SecretKey  -> Secret Key (sk_...) para buscar email/nome do usuário
